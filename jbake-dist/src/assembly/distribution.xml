<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">

    <id>bin</id>

    <formats>
        <format>zip</format>
    </formats>

    <fileSets>
        <!-- The binary ZIP uses the self-contained shaded JAR, avoiding duplicate dependency JARs. -->
        <fileSet>
            <directory>${project.basedir}/src/dist/bin</directory>
            <outputDirectory>/bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- Optionally include resources -->
        <fileSet>
            <directory>${project.basedir}/src/main/resources</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>**</include>
            </includes>
            <useDefaultExcludes>false</useDefaultExcludes>
        </fileSet>

        <!-- Optionally include README or scripts -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>README*</include>
            </includes>
        </fileSet>

        <!-- Include lib/logging directory with logback.xml (matches Gradle's src/dist behavior) -->
        <fileSet>
            <directory>${project.basedir}/src/dist/lib/logging</directory>
            <outputDirectory>/lib/logging</outputDirectory>
            <includes>
                <include>**/*.xml</include>
            </includes>
        </fileSet>
    </fileSets>

    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>/lib</outputDirectory>
            <destName>jbake.jar</destName>
            <fileMode>0644</fileMode>
        </file>
    </files>

</assembly>
